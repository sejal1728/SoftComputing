# McCulloch-Pitts Model for AND Gate 

 

def mp_neuron(x1, x2): 

    weights = [1, 1] 

    threshold = 2 

 

    net = x1 * weights[0] + x2 * weights[1] 

 

    if net >= threshold: 

        return 1 

    else: 

        return 0 

 

print("X1  X2  Output") 

for x1 in [0, 1]: 

    for x2 in [0, 1]: 

        output = mp_neuron(x1, x2) 

        print(x1, " ", x2, " ", output) 

 
