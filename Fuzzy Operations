# Define fuzzy sets A and B 
A = {'x1': 0.2, 'x2': 0.7, 'x3': 1.0} 
B = {'x1': 0.5, 'x2': 0.4, 'x3': 0.9} 
 
# Fuzzy Union 
def fuzzy_union(A, B): 
    return {x: max(A[x], B[x]) for x in A} 
 
# Fuzzy Intersection 
def fuzzy_intersection(A, B): 
    return {x: min(A[x], B[x]) for x in A} 
 
# Fuzzy Complement 
def fuzzy_complement(A): 
    return {x: 1 - A[x] for x in A} 
 
# Fuzzy Algebraic Sum 
def fuzzy_algebraic_sum(A, B): 
    return {x: A[x] + B[x] - A[x] * B[x] for x in A} 
 
# Fuzzy Algebraic Product 
def fuzzy_algebraic_product(A, B): 
    return {x: A[x] * B[x] for x in A} 
 
# Fuzzy Cartesian Product 
def fuzzy_cartesian_product(A, B): 
    return {(x, y): min(A[x], B[y]) 
            for x in A for y in B} 
 
# Display results 
print("Fuzzy Set A:", A) 
print("Fuzzy Set B:", B) 
print("\nUnion:", fuzzy_union(A, B)) 
print("Intersection:", fuzzy_intersection(A, B)) 
print("Complement of A:", fuzzy_complement(A)) 
print("Algebraic Sum:", fuzzy_algebraic_sum(A, B)) 
print("Algebraic Product:", fuzzy_algebraic_product(A, B)) 
 
print("Cartesian Product:") 
for pair, val in fuzzy_cartesian_product(A, B).items(): 
    print(f"{pair}: {val}") 
